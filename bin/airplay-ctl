#!/usr/bin/env bash
# Control surface for the blacksheep.airplay bar widget.
#
# Everything the panel does goes through here rather than through QML calling
# the binary directly, so the JSON shapes and the session lifecycle live in one
# testable place. Every subcommand prints a single JSON object on stdout;
# diagnostics go to stderr.
#
#   status                     what is running now
#   discover [timeout]         receivers on the network
#   windows                    open windows, for "just an app" mode
#   start <host> screen|extend|window [target] [audio=on|off]
#                              audio=on adds `--audio system` (default off)
#   audio-pref [on|off]        read or set the panel's "Send audio" default
#   pair-start <host>          ask the receiver to show a code; holds the
#                              connection open while the human reads it
#   pair-code <host> <code>    send the code on that same connection
#   pair-cancel <host>         give up without spending an attempt
#   stop
#   cleanup                    clear a leftover virtual output, and put back an
#                              output a killed audio session left configured
#
# A session runs as a transient systemd user unit. That buys three things a
# bare background process does not: it survives a shell reload, the unit name
# makes "one session at a time" structural, and `systemctl --user stop` sends
# SIGTERM straight into the teardown path the daemon has tests for.

set -uo pipefail

UNIT="airplay-session"

airplay_bin() {
  local c
  c="$(command -v airplay 2>/dev/null)" && { printf '%s' "$c"; return 0; }
  for c in "$HOME/.local/bin/airplay" "$HOME/Work/airplay-rs/target/release/airplay"; do
    [[ -x "$c" ]] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

fail() {
  printf '{"ok":false,"error":%s}\n' "$(printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')"
  exit 0   # The panel reads JSON, so an error is data, not an exit code.
}

BIN="$(airplay_bin)" || fail "the airplay binary was not found on PATH or in ~/Work/airplay-rs/target/release"

unit_active() { systemctl --user is-active --quiet "$UNIT" 2>/dev/null; }

# The "Send audio" switch, remembered across shell reloads. OFF unless Jon has
# turned it on: with audio on the session moves the TV's volume, and the Rust
# audio path has not been checked on the TV yet. Anything but "on" reads as off.
AUDIO_PREF="${XDG_STATE_HOME:-$HOME/.local/state}/blacksheep.airplay/audio"
audio_pref() { [[ "$(cat "$AUDIO_PREF" 2>/dev/null)" == "on" ]] && printf on || printf off; }

# ---- pairing helpers -------------------------------------------------------
# One directory per receiver under the runtime dir, holding the input the
# sender is reading and the JSON it has written.
PAIR_ROOT="${XDG_RUNTIME_DIR:-/tmp}/blacksheep.airplay/pair"
pair_dir() { printf '%s/%s' "$PAIR_ROOT" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"; }
pair_kill() {
  local d; d="$(pair_dir "$1")"
  pkill -f "tail -f $d/in" 2>/dev/null
  pkill -f "pair $1 --interactive" 2>/dev/null
  rm -rf "$d" 2>/dev/null
  return 0
}

# Which receivers we hold credentials for. Offline: no mDNS, no receiver
# contacted, safe to call on every status poll.
paired_hosts() { "$BIN" pair --list --json 2>/dev/null || printf '{"paired":[]}'; }

case "${1:-status}" in

  status)
    # The daemon's own view (which output, which workspace, orphan or not),
    # plus whether our unit is up. The unit answers for --output and --window
    # sessions too, which write no ownership claim.
    daemon="$("$BIN" status --json 2>/dev/null)" || daemon=""
    [[ -z "$daemon" ]] && daemon="null"
    active=false; unit_active && active=true
    desc="$(systemctl --user show -p Description --value "$UNIT" 2>/dev/null)"
    # Title-free record of whether the running unit was started with audio
    # (set by `start` via --setenv); the description embeds a window title.
    unit_env="$(systemctl --user show -p Environment --value "$UNIT" 2>/dev/null)"
    DAEMON="$daemon" ACTIVE="$active" DESC="${desc:-}" UNIT_ENV="${unit_env:-}" PREF="$(audio_pref)" PAIRED="$(paired_hosts)" python3 - <<'PY'
import json, os
raw = os.environ.get("DAEMON") or "null"
try:
    d = json.loads(raw)
except Exception:
    d = None
if not isinstance(d, dict):
    d = {}
active = os.environ.get("ACTIVE") == "true"
desc = os.environ.get("DESC") or None
# systemd echoes "<unit>.service" as the Description of a unit that does not
# exist, which would read as a live session to the panel.
if not active or desc == "airplay-session.service":
    desc = None
# True/False only for an active unit that carries the marker; None otherwise
# (the panel then falls back to the description).
try:
    paired = [p.get("host") for p in json.loads(os.environ.get("PAIRED") or "{}").get("paired", [])]
except Exception:
    paired = []
unit_audio = None
if active:
    env = (os.environ.get("UNIT_ENV") or "").split()
    if "AIRPLAY_PANEL_AUDIO=on" in env:
        unit_audio = True
    elif "AIRPLAY_PANEL_AUDIO=off" in env:
        unit_audio = False
out = {
    "ok": True,
    "unit_active": active,
    "unit_description": desc,
    "unit_audio": unit_audio,
    "session": d.get("session"),
    "orphan": d.get("orphan"),
    "audio_pref": os.environ.get("PREF") == "on",
    # Hosts we hold credentials for, so the panel can mark a receiver paired
    # and skip offering to pair it again. Read from disk, not the network.
    "paired": paired,
}
print(json.dumps(out))
PY
    ;;

  discover)
    t="${2:-4}"
    out="$("$BIN" discover --json --timeout "$t" 2>/dev/null)" || out=""
    if [[ -z "$out" ]]; then
      printf '{"ok":true,"receivers":[]}\n'
    else
      OUT="$out" python3 - <<'PY'
import json, os
try:
    d = json.loads(os.environ["OUT"])
    rs = d.get("receivers", []) if isinstance(d, dict) else []
except Exception:
    rs = []
# What the sender can actually drive, stated honestly so the panel never
# offers a click that is bound to fail.
#
#   yes      - proven end to end: Samsung Frame (LS*), transient pairing, no
#              FairPlay needed.
#   no       - Apple TV. Screen mirroring to it requires FairPlay, which the
#              sender does not implement; a session would fail at setup.
#   untested - a Mac receiver: may well need FairPlay too, never tried.
#   audio    - speakers (Sonos, HomePod, amps): they announce on the same
#              port, but audio is not in the sender yet.
def classify(r):
    m = (r.get("model") or "").upper().replace(",", "")
    if m.startswith("LS"):
        return True, "yes", ""
    if "APPLETV" in m:
        return True, "no", "Apple TV needs FairPlay, which this sender does not support yet"
    if m.startswith("MAC"):
        return True, "untested", "A Mac as a receiver has not been tried; it may need FairPlay"
    return False, "audio", "Audio receiver — audio is not in the sender yet"

for r in rs:
    display, support, reason = classify(r)
    r["display"] = display
    r["support"] = support
    if reason:
        r["reason"] = reason

order = {"yes": 0, "untested": 1, "no": 2, "audio": 3}
rs.sort(key=lambda r: (order[r["support"]], (r.get("name") or "").lower()))
print(json.dumps({"ok": True, "receivers": rs}))
PY
    fi
    ;;

  windows)
    hyprctl clients -j 2>/dev/null | python3 -c '
import json, sys
try:
    cs = json.load(sys.stdin)
except Exception:
    cs = []
out = []
for c in cs:
    title = c.get("title") or ""
    cls = c.get("class") or ""
    if not title:
        continue
    out.append({"title": title, "app": cls, "workspace": (c.get("workspace") or {}).get("id")})
out.sort(key=lambda w: (w["app"].lower(), w["title"].lower()))
print(json.dumps({"ok": True, "windows": out}))
' || printf '{"ok":true,"windows":[]}\n'
    ;;

  start)
    host="${2:-}"; mode="${3:-extend}"; target="${4:-}"; audio="${5:-audio=off}"
    [[ -n "$host" ]] || fail "start needs a receiver address"
    case "$audio" in
      audio=on|on) audio=on ;;
      audio=off|off|"") audio=off ;;
      *) fail "audio must be audio=on or audio=off, not $audio" ;;
    esac
    unit_active && fail "a session is already running — stop it first"

    args=("$BIN" mirror "$host")
    case "$mode" in
      extend) args+=(--extend) ;;
      screen)
        # Whole-screen mirroring needs a real output name; the panel passes the
        # focused one, and eDP-1 is the fallback on this laptop.
        args+=(--output "${target:-eDP-1}") ;;
      window)
        [[ -n "$target" ]] || fail "app mode needs a window title"
        args+=(--window "$target") ;;
      *) fail "unknown mode $mode" ;;
    esac
    args+=(--seconds 0)
    # System audio. `--audio system` now means SINK mode: the sender publishes
    # its own output named after the receiver and the laptop's sound goes to
    # the TV instead of the speakers, switching back when the run ends. The
    # capture backend, latency, A/V offset and volume sync all stay at the
    # sender's defaults (sink, 300 ms, 0 UNCALIBRATED, on); `--audio-capture
    # pipewire` is the escape hatch that keeps the sound on the laptop too, and
    # is deliberately not exposed here — it is a triage flag, not a choice.
    [[ "$audio" == on ]] && args+=(--audio system)

    label="$mode"
    [[ -n "$target" ]] && label="$mode: $target"
    [[ "$audio" == on ]] && label="$label + audio"
    if systemd-run --user --quiet \
         --unit="$UNIT" \
         --description="AirPlay $label -> $host" \
         --setenv=AIRPLAY_PANEL_AUDIO="$audio" \
         --collect \
         -- "${args[@]}" >/dev/null 2>&1; then
      printf '{"ok":true,"started":true}\n'
    else
      fail "systemd-run refused to start the session (try: journalctl --user -u $UNIT -n 20)"
    fi
    ;;

  audio-pref)
    case "${2:-}" in
      "") ;;
      on|off)
        mkdir -p "$(dirname "$AUDIO_PREF")" || fail "cannot create $(dirname "$AUDIO_PREF")"
        printf '%s\n' "$2" > "$AUDIO_PREF.tmp" && mv -f "$AUDIO_PREF.tmp" "$AUDIO_PREF" \
          || fail "cannot write $AUDIO_PREF"
        ;;
      *) fail "audio-pref takes on or off" ;;
    esac
    if [[ "$(audio_pref)" == on ]]; then v=true; else v=false; fi
    printf '{"ok":true,"audio_pref":%s}\n' "$v"
    ;;

  stop)
    systemctl --user stop "$UNIT" >/dev/null 2>&1
    printf '{"ok":true,"stopped":true}\n'
    ;;

  cleanup)
    msg="$("$BIN" extend --cleanup 2>&1)"
    # A killed audio session leaves nothing visible — the sink node dies with
    # its process — but it can leave the machine CONFIGURED for a sink that no
    # longer exists, so the output Jon had before the crash never comes back.
    # That belongs to the same button. Skipped while a session runs, because a
    # live sender holds the lock and the cleanup would answer "busy".
    if ! unit_active; then
      msg="$msg"$'\n'"$("$BIN" audio --cleanup 2>&1)"
    fi
    MSG="$msg" python3 -c '
import json, os
print(json.dumps({"ok": True, "message": os.environ.get("MSG", "").strip()}))'
    ;;

  pair-start)
    # Ask the receiver to put a code on its screen, and KEEP THE CONNECTION
    # OPEN while the human reads it. That is not a nicety: pair-setup state
    # belongs to the connection, so a code submitted by a later process is
    # always stale — measured on the Frame, which issued 1878 and then refused
    # it. One process, one socket, the human in the middle.
    host="${2:-}"
    [[ -n "$host" ]] || fail "pair-start needs a receiver address"
    d="$(pair_dir "$host")"
    pair_kill "$host"
    mkdir -p "$d" || fail "cannot create $d"
    : > "$d/in"; : > "$d/out"; : > "$d/err"
    # `tail -f` holds stdin open; without a writer the sender would see EOF
    # and treat it as a cancel.
    setsid bash -c "tail -f '$d/in' | '$BIN' pair '$host' --interactive --json --timeout 300 > '$d/out' 2> '$d/err'" \
      >/dev/null 2>&1 &
    # The first line is emitted and flushed before the sender blocks on stdin,
    # so waiting for it is waiting for "the code is on the screen".
    #
    # The budget is 40 s rather than 15 as tolerance, NOT as a diagnosis. One
    # first attempt has been seen to fail and the retry immediately succeed,
    # with the TV awake and already on its AirPlay screen — so the Art Mode
    # wake-up theory is refuted. The journal shows mirror sessions connected in
    # the same minute, so a receiver refusing to start a pairing while a
    # session holds it is the standing suspicion; it is not established, and
    # the failure has not recurred. If it does, capture the error text: the
    # distinction that matters is "did not answer" (a timeout, which a longer
    # budget fixes) against anything else (a refusal, which it does not).
    for _ in $(seq 1 160); do
      [[ -s "$d/out" ]] && break
      sleep 0.25
    done
    if [[ -s "$d/out" ]]; then
      head -1 "$d/out"
    else
      err="$(tail -c 400 "$d/err" 2>/dev/null)"
      pair_kill "$host"
      fail "${err:-$host did not answer in 40s — if its screen was off it may be waking up; try again}"
    fi
    ;;

  pair-code)
    host="${2:-}"; code="${3:-}"
    [[ -n "$host" ]] || fail "pair-code needs a receiver address"
    d="$(pair_dir "$host")"
    [[ -d "$d" && -s "$d/out" ]] || fail "no pairing is waiting for a code — start one first"
    [[ "$code" =~ ^[0-9]{4}$ ]] || fail "the code is four digits"
    printf '%s\n' "$code" >> "$d/in"
    for _ in $(seq 1 80); do
      [[ "$(wc -l < "$d/out")" -ge 2 ]] && break
      sleep 0.25
    done
    line="$(sed -n 2p "$d/out")"
    pair_kill "$host"
    if [[ -n "$line" ]]; then
      printf '%s\n' "$line"
    else
      fail "the receiver did not answer after the code was sent"
    fi
    ;;

  pair-cancel)
    # Closing the input ends the run BEFORE a proof is built, so a cancel
    # never spends one of the receiver's few allowed attempts.
    host="${2:-}"
    [[ -n "$host" ]] || fail "pair-cancel needs a receiver address"
    pair_kill "$host"
    printf '{"ok":true,"cancelled":true}\n'
    ;;

  *)
    fail "unknown subcommand ${1:-}"
    ;;
esac
